# Copy to .env (git-ignored) and fill in. Real environment variables win over .env.
RO_SMTP_HOST=smtp.gmail.com
RO_SMTP_PORT=587
RO_SMTP_USER=you@example.com
# For Gmail use an App Password, not your account password.
RO_SMTP_PASSWORD=
RO_EMAIL_FROM=you@example.com
# Comma-separated list of recipients
RO_EMAIL_TO=you@example.com

# Contact details: only used if mode=auto_order AND the platform needs no OTP/card.
RO_CONTACT_NAME=
RO_CONTACT_PHONE=
RO_CONTACT_EMAIL=
