# Price Watcher configuration — copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is committed. Never put your real email or
# password into `.env.example`.

# ---- Email (SMTP) ----
# Recipient address — where price-change emails go. Put your own address here.
PW_EMAIL_TO=your.email@example.com

# SMTP server. Defaults below are for Gmail with an app password.
# Create one at https://myaccount.google.com/apppasswords (requires 2FA on the account).
PW_SMTP_HOST=smtp.gmail.com
PW_SMTP_PORT=587
PW_SMTP_USER=your.email@example.com
PW_SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Address used as the From header. Usually the same as PW_SMTP_USER.
PW_EMAIL_FROM=your.email@example.com

# ---- Check behaviour ----
# How many consecutive failures before a "watch is broken" email is sent.
PW_FAILURE_THRESHOLD=6
# Guard: if a new price differs from the last by more than this percent, defer by one run.
PW_SANITY_JUMP_PCT=90
# Random per-link delay (seconds) during a check, to avoid bursts against a single shop.
PW_DELAY_MIN_SEC=2
PW_DELAY_MAX_SEC=8

# ---- Supermarket scan ----
# Which cities' stores are scanned. Empty = the cities marked ON in _REGIONS in
# src/price_watcher/supermarkets.py (now Herzliya and Ramat HaSharon; the other
# Sharon cities, Tel Aviv and the Rishon LeZion area are listed there as OFF).
# Otherwise a comma-separated list of city or region names from that table,
# e.g. PW_MEAT_CITIES=הרצליה,רמת השרון,תל אביב   or   PW_MEAT_CITIES=הכל
PW_MEAT_CITIES=
# Max stores to scan per chain in each region. 0 = every store in the cities.
PW_STORES_PER_REGION=0
# How many deals each meat-category table of the daily email shows: the
# cheapest ones by promo price per kg.
PW_TOP_PER_CATEGORY=5

# ---- Vacation deals ----
# Extra recipients (comma-separated) who get ONLY the vacation-deals email,
# never the full daily report. PW_EMAIL_TO gets the deals as a section at the
# bottom of the daily report. Leave empty to send no deals-only email.
PW_DEALS_EMAIL_TO=
# How many of the cheapest packages, and of the cheapest flights, to show.
PW_DEALS_TOP=15
# Only show deals departing within this many days. 0 = no limit.
PW_DEALS_DAYS=0

# ---- Logging ----
# DEBUG, INFO, WARNING, ERROR
PW_LOG_LEVEL=INFO
