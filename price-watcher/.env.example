# Price Watcher configuration — copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is committed. Never put your real email or
# password into `.env.example`.

# ---- Email (SMTP) ----
# Recipient address — where price-change emails go. Put your own address here.
PW_EMAIL_TO=your.email@example.com

# SMTP server. Defaults below are for Gmail with an app password.
# Create one at https://myaccount.google.com/apppasswords (requires 2FA on the account).
PW_SMTP_HOST=smtp.gmail.com
PW_SMTP_PORT=587
PW_SMTP_USER=your.email@example.com
PW_SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Address used as the From header. Usually the same as PW_SMTP_USER.
PW_EMAIL_FROM=your.email@example.com

# ---- Check behaviour ----
# How many consecutive failures before a "watch is broken" email is sent.
PW_FAILURE_THRESHOLD=6
# Guard: if a new price differs from the last by more than this percent, defer by one run.
PW_SANITY_JUMP_PCT=90
# Random per-link delay (seconds) during a check, to avoid bursts against a single shop.
PW_DELAY_MIN_SEC=2
PW_DELAY_MAX_SEC=8

# ---- Supermarket scan ----
# Which cities' stores are scanned. Empty = the cities marked ON in _REGIONS in
# src/price_watcher/supermarkets.py (now Herzliya and Ramat HaSharon; the other
# Sharon cities, Tel Aviv and the Rishon LeZion area are listed there as OFF).
# Otherwise a comma-separated list of city or region names from that table,
# e.g. PW_MEAT_CITIES=הרצליה,רמת השרון,תל אביב   or   PW_MEAT_CITIES=הכל
# ASCII names work too: herzliya, ramat-hasharon, raanana, kfar-saba, ...,
# the regions sharon, tel-aviv, rishon, or "all" (e.g. sharon,tel-aviv,rishon
# for the old wider scope). PW_MEAT_REGIONS is accepted as an older name for
# this setting and is only read when PW_MEAT_CITIES is empty.
PW_MEAT_CITIES=
# Max stores to scan per chain in each region. 0 = every store in the cities.
PW_STORES_PER_REGION=0
# How many deals each meat-category table of the daily email shows: the
# cheapest ones by promo price per kg. (PW_MEAT_TOP_PER_CATEGORY is accepted
# as an older name and only read when this one is not set.)
PW_TOP_PER_CATEGORY=5
# Where Super Bareket (סופר ברקת) publishes its price files:
#   bina:<portal sub-domain or URL> | publishedprices:<username> | off
# Empty = bina:superbareket (superbareket.binaprojects.com).
PW_BAREKET_SOURCE=

# ---- Vacation deals ----
# Extra recipients (comma-separated) who get ONLY the vacation-deals email,
# never the full daily report. PW_EMAIL_TO gets the deals as a section at the
# bottom of the daily report. Leave empty to send no deals-only email.
PW_DEALS_EMAIL_TO=
# Packages and flights are each grouped by continent (Europe, Asia, North
# America, South America, Africa, Oceania), cheapest first within a continent.
# Europe: up to this many packages, and this many flights.
PW_DEALS_TOP=15
# Europe: only departures from today to today + this many days.
PW_DEALS_EUROPE_DAYS=50
# Every other continent: this many deals each (Asia always includes a Japan
# and a Thailand deal when one exists; the email says when one is missing)...
PW_DEALS_OTHER_TOP=4
# ...departing from today to today + this many days.
PW_DEALS_OTHER_DAYS=365
# Extra cap on every window above, in days. 0 = no extra cap.
PW_DEALS_DAYS=0

# ---- Facebook Marketplace (daily email section; see docs/facebook-marketplace.md) ----
# ;-separated search queries, optional max price after "|", e.g.
#   PW_FB_QUERIES=iphone 13|2000;כיסא משרדי
# Empty = feature off (no section in the daily email).
PW_FB_QUERIES=
# Optional location slug / id used in the Marketplace URL (e.g. telaviv).
PW_FB_LOCATION=
# Optional search radius (km; unverified URL parameter) and a default max price
# for queries without one.
PW_FB_RADIUS_KM=
PW_FB_MAX_PRICE=
# Prices at or below this are placeholders ("1 ₪") and are ignored.
PW_FB_NOISE_MAX=1
# A drop must be at least this many ₪ AND this percent to be reported.
PW_FB_MIN_DROP_ILS=20
PW_FB_MIN_DROP_PCT=5
# 1 = also list new listings; 0 = price drops only.
PW_FB_REPORT_NEW=1
# Max listings in the section; forget listings not seen for this many days.
PW_FB_MAX_ITEMS=20
PW_FB_FORGET_DAYS=30

# ---- Logging ----
# DEBUG, INFO, WARNING, ERROR
PW_LOG_LEVEL=INFO
