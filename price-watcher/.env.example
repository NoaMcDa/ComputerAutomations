# Price Watcher configuration — copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is committed. Never put your real email or
# password into `.env.example`.

# ---- Email (SMTP) ----
# Recipient address — where price-change emails go. Put your own address here.
PW_EMAIL_TO=your.email@example.com

# SMTP server. Defaults below are for Gmail with an app password.
# Create one at https://myaccount.google.com/apppasswords (requires 2FA on the account).
PW_SMTP_HOST=smtp.gmail.com
PW_SMTP_PORT=587
PW_SMTP_USER=your.email@example.com
PW_SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Address used as the From header. Usually the same as PW_SMTP_USER.
PW_EMAIL_FROM=your.email@example.com

# ---- Check behaviour ----
# How many consecutive failures before a "watch is broken" email is sent.
PW_FAILURE_THRESHOLD=6
# Guard: if a new price differs from the last by more than this percent, defer by one run.
PW_SANITY_JUMP_PCT=90
# Random per-link delay (seconds) during a check, to avoid bursts against a single shop.
PW_DELAY_MIN_SEC=2
PW_DELAY_MAX_SEC=8

# ---- Supermarket scan ----
# Cities whose stores are scanned: comma-separated city or region names, Hebrew
# or the slugs in _REGIONS (src/price_watcher/supermarkets.py), or "all".
# Default: herzliya,ramat-hasharon. Other cities stay available, e.g.
#   PW_MEAT_REGIONS=sharon,tel-aviv,rishon   (the previous scope)
#   PW_MEAT_REGIONS=herzliya,raanana,kfar-saba
PW_MEAT_REGIONS=herzliya,ramat-hasharon
# Max stores to scan per chain in each region. 0 = every store in the cities
# above. Set e.g. 2 for a quick run.
PW_STORES_PER_REGION=0
# How many of the cheapest deals (promo price per kg) to show in each meat
# category (one cut of one animal) in the daily email. Replaces PW_TOP_PER_REGION.
PW_MEAT_TOP_PER_CATEGORY=5
# Where Bareket (ברקת) publishes its price files:
#   bina:<portal URL> | publishedprices:<username> | off
PW_BAREKET_SOURCE=bina:https://superbareket.binaprojects.com

# ---- Facebook Marketplace (daily email section; see docs/facebook-marketplace.md) ----
# ;-separated search queries, optional max price after "|". Empty = feature off.
PW_FB_QUERIES=
# Optional location slug / id used in the Marketplace URL (e.g. telaviv).
PW_FB_LOCATION=
# A drop must be at least this many ₪ AND this percent to be reported.
PW_FB_MIN_DROP_ILS=20
PW_FB_MIN_DROP_PCT=5

# ---- Logging ----
# DEBUG, INFO, WARNING, ERROR
PW_LOG_LEVEL=INFO
